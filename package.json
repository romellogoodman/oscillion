{
  "name": "oscillion",
  "private": true,
  "workspaces": [
    "apps/tool",
    "apps/site"
  ],
  "scripts": {
    "dev": "npm run dev -w oscillon-tool",
    "dev:site": "npm run dev -w oscillon-site",
    "render": "npm run render -w oscillon-tool --",
    "test": "npm run test -w oscillon-tool",
    "verify:quick": "npm run verify:quick -w oscillon-tool",
    "verify:final": "npm run verify:final -w oscillon-tool",
    "test:browser": "npm run test:browser -w oscillon-tool",
    "build": "npm run build -w oscillon-tool && npm run build -w oscillon-site"
  }
}
